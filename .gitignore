# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Runtime data (regenerated by the app; don't commit the SQLite DB)
data/*.db
data/*.sqlite
data/*.sqlite3

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
.coverage
htmlcov/

# local editor / Claude Code tooling (machine-specific paths)
.claude/

# n8n automation outputs (generated)
automation/evals/results/
automation/briefings/*.md
automation/dev/requests.jsonl

# Secrets: environment files with API keys must never be committed
.env
.env.*
!.env.example
